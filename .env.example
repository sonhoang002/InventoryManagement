# Express
PORT=5000
NODE_ENV=development

# Local PostgreSQL database
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_USER=your_postgres_user
LOCAL_DB_PASSWORD=your_postgres_password
LOCAL_DB_NAME=maple

# Passcode required to add, update, or delete monsters
MONSTER_ADMIN_PASSCODE=choose_a_secret_passcode

# Hosted PostgreSQL database (used by npm run db:seed)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
