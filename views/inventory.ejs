<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <%- include("./partial/redirectHeader") %>

    <div class="allMonstersDiv">
      <% monsters.forEach((monster) => { %>
        <div class="monsterDiv">
           <div class="upperMonsterDiv">
            <div><%= monster.monstername %></div>
            <div><%= monster.level  %></div>
          </div>
          <div class="lowerMonsterDiv">
            <div><%= monster.type  %></div>
            <div><%= monster.element  %></div>
          </div>
        </div>
      <% }) %>
    </div>
  </body>
</html>
